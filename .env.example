# Suraksha Sentinel AI Environment Configuration

# Server Host and Port
SENTINEL_API_HOST="0.0.0.0"
SENTINEL_API_PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
SENTINEL_LOG_LEVEL="INFO"

# Hardware Device for YOLO11 Inference ("cpu" or "cuda")
SENTINEL_MODEL_DEVICE="cpu"

# Demo Mode (If true, generates mock detections on empty videos. Set to false for real deployment)
DEMO_MODE="false"

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
